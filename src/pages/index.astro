---
import '../styles/global.css';
import LinkButton from '../components/LinkButton.astro';
import Profile from '../components/Profile.astro';
import Layout from '../layouts/Layout.astro';

import Github from '../assets/svg/github.svg';
import Instagram from '../assets/svg/instagram.svg';
import LinkedIn from '../assets/svg/linkedin.svg';
import X from '../assets/svg/x.svg';
import Arrow from '../assets/svg/arrow.svg';
import Email from '../assets/svg/email.svg';
import WhatsApp from '../assets/svg/whatsapp.svg';

const WHATSAPP = '595XXXXXXXXX'; // tu número, formato internacional sin + ni espacios
const waMsg = encodeURIComponent('Hola Pablo, vi tu página y me gustaría consultarte sobre un proyecto.');
const mailSubject = encodeURIComponent('Consulta sobre proyecto web');

// Acciones principales: lo que querés que haga un cliente
const contact = [
	{
		url: `https://wa.me/${WHATSAPP}?text=${waMsg}`,
		text: 'Escribime por WhatsApp',
		variant: 'primary',
		logo: { image: WhatsApp /* cambiar por WhatsApp */ },
	},
	{
		url: `mailto:pablogamarra.dev@gmail.com?subject=${mailSubject}`,
		text: 'Enviame un correo',
		variant: 'secondary',
		logo: { image: Email },
	},
	{
		url: 'https://pablolgamarra.vercel.app/',
		text: 'Ver portafolio y proyectos',
		variant: 'secondary',
		logo: { image: Arrow },
	},
];

// Secundarias: solo íconos
const social = [
	{ url: 'https://linkedin.com/in/pablolgamarra', text: 'LinkedIn', logo: LinkedIn },
	{ url: 'https://github.com/pablolgamarra', text: 'GitHub', logo: Github },
	{ url: 'https://instagram.com/pablolgamarra', text: 'Instagram', logo: Instagram },
	{ url: 'https://x.com/pablolgamarra', text: 'X (Twitter)', logo: X },
];

const services = [
	{ title: 'Sitios web y landing pages', desc: 'Rápidos, adaptables a móvil y listos para que te encuentren.' },
	{ title: 'Aplicaciones web a medida', desc: 'Sistemas de gestión, paneles y automatización de procesos.' },
	{ title: 'Mejora de sitios existentes', desc: 'Rendimiento, diseño y mantenimiento de lo que ya tenés.' },
];
---

<Layout>
	<Profile
		name='Pablo Gamarra'
		bio=`Ingeniero en Informática\nDesarrollador de software y aplicaciones web\n`
		tagline='Creo sitios y aplicaciones para negocios y profesionales. Disponible para nuevos proyectos.'
		image='/images/profile.webp'
	/>

	<section class='links' aria-label='Contacto'>
		{contact.map((c) => (
			<LinkButton url={c.url} text={c.text} logo={c.logo} variant={c.variant} />
		))}
	</section>

	<section class='services' aria-labelledby='services-title'>
		<h2 id='services-title'>¿En qué puedo ayudarte?</h2>
		<ul>
			{services.map((s) => (
				<li>
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</li>
			))}
		</ul>
	</section>

	<nav class='social' aria-label='Redes sociales'>
        {social.map((s) => (
            <a href={s.url} target='_blank' rel='noopener noreferrer' aria-label={s.text}>
                <img src={s.logo.src} alt='' width='24' height='24' />
            </a>
        ))}
    </nav>
</Layout>