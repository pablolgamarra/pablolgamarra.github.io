---
import '../styles/global.css';
import LinkButton from '../components/LinkButton.astro';
import Profile from '../components/Profile.astro';
import Layout from '../layouts/Layout.astro';

import Github from '../assets/svg/github.svg';
import Instagram from '../assets/svg/instagram.svg';
import LinkedIn from '../assets/svg/linkedin.svg';
import X from '../assets/svg/x.svg';
import Arrow from '../assets/svg/arrow.svg';
import Email from '../assets/svg/email.svg';

const social = [
	{ url: 'https://github.com/pablolgamarra', text: 'GitHub', logo: { image: Github, width: 100, height: 100 } },
	{ url: 'https://linkedin.com/in/pablolgamarra', text: 'LinkedIn', logo: { image: LinkedIn } },
	{ url: 'https://instagram.com/pablolgamarra', text: 'Instagram', logo: { image: Instagram } },
	{ url: 'https://x.com/pablolgamarra', text: 'Twitter', logo: { image: X } },
	{ url: 'https://pablolgamarra.vercel.app/', text: 'Portafolio', logo: { image: Arrow } },
	{ url: 'mailto:pablogamarra.dev@gmail.com', text: 'Email', logo: { image: Email } },
];
---

<Layout>
	<Profile
		name='Pablo Gamarra'
		bio='Desarrollador Web | Técnico Superior en Informática'
		image='/images/profile.webp'
	/>

	<section class='links'>
		{
			social.map((social) => (
				<LinkButton
					url={social.url}
					text={social.text}
					logo={social.logo ? social.logo : undefined}
				/>
			))
		}
	</section>
</Layout>
