---
const { name, image, bio } = Astro.props;
---

<div class='profile'>
    <div class="bio-card">
        <img
            src={image}
            alt={name}
            class='avatar'
        />
        <h1 class='text-xl font-bold mt-2'>{name}</h1>
        <h2 class='text-gray-600 text-sm'>{bio}</h2>
    </div>
</div>
