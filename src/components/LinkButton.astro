---
const { url, text, logo, variant = 'secondary' } = Astro.props;
---
<a class={`link-button link-button--${variant}`} href={url}
   target={url.startsWith('http') ? '_blank' : undefined}
   rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}>
	{logo && <img src={logo.image.src ?? logo.image} alt='' width='24' height='24' />}
	<span>{text}</span>
</a>